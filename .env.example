PORT=3000

# Local MySQL. XAMPP's root user has an empty password.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=blueorbit_web

# Hubble Cloud credentials. The browser never sees these.
# Copy this file to .env and fill in hubbleOrgId and hubbleApiToken.
HUBBLE_ORG_ID=
HUBBLE_API_TOKEN=

# Public address of this website. Verification and reset links use it.
# Production: http://hxq.rbj.temporary.site/blueorbit
APP_URL=http://127.0.0.1:5173

# Brevo SMTP. Use the same values in dev and production.
# SMTP_USER is the SMTP login from Brevo (ends in @smtp-brevo.com), and
# SMTP_PASSWORD is a Brevo SMTP key. Both come from SMTP & API → SMTP.
# SMTP_FROM must be on a domain authenticated in Brevo.
# Each server's public IP must be on Brevo's authorized IP list.
# If outbound port 587 is blocked, set SMTP_PORT=2525.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=MedsTemp
SMTP_REPLY_TO=

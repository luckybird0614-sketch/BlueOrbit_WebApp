PORT=3000

# Local MySQL. XAMPP's root user has an empty password.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=blueorbit_web

# Hubble Cloud credentials. The browser never sees these.
# Copy this file to .env and fill in hubbleOrgId and hubbleApiToken.
HUBBLE_ORG_ID=
HUBBLE_API_TOKEN=

# Public address of this website. Verification and reset links use it.
APP_URL=http://127.0.0.1:5173

# SMTP account used to send verification and password-reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
